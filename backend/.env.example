# APEX backend configuration (local defaults shown)
# The Java app reads ENVIRONMENT VARIABLES; it does not load .env automatically.
# Locally you may export a copy of this file; on Railway set DATABASE_URL as an
# app-service reference to the Postgres service (e.g. ${{Postgres.DATABASE_URL}}).

# ---- HTTP ----
# Port the server listens on. Railway injects this automatically.
PORT=3030

# ---- Database (PostgreSQL) ----
# Preferred: one URL (Railway PostgreSQL provides this).
#   postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# For local dev:  postgres://apex:apex@127.0.0.1:5432/apex
DATABASE_URL=

# Alternative: individual PG variables (used when DATABASE_URL is empty)
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=apex
# PGPASSWORD=
# PGDATABASE=apex
# PGSSLMODE=require

# ---- App ----
# APEX_HOME=/app/backend
# APEX_STATIC=/app/frontend
# APEX_UPLOADS=/app/backend/uploads

# Admin account - seeded ONCE on first start, never re-created afterwards.
APEX_ADMIN_USER=admin
APEX_ADMIN_PASS=admin1234

# Session lifetime in hours
APEX_SESSION_HOURS=24

# Connection pool size
APEX_DB_POOL=5
